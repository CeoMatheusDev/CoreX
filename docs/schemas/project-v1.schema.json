{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreX Project v1",
  "description": "Validação estrutural. Regras semânticas adicionais em docs/PROJECT_SCHEMA_V1.md são normativas. Não comprova disponibilidade de recursos do core.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "engine", "renderer", "scenes", "scripts", "assets", "simulation"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "uuid", "version", "created_at"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "version": {"$ref": "#/$defs/semver"},
        "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    },
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "graphics_backend"],
      "properties": {
        "version": {"$ref": "#/$defs/semver"},
        "graphics_backend": {"enum": ["vulkan", "webgpu", "d3d12", "metal"]}
      }
    },
    "renderer": {
      "type": "object", "additionalProperties": false,
      "required": ["graphics_preset", "vsync", "initial_resolution"],
      "properties": {
        "graphics_preset": {"enum": ["low", "medium", "high"]},
        "vsync": {"type": "boolean"},
        "initial_resolution": {
          "type": "object", "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 64, "maximum": 16384},
            "height": {"type": "integer", "minimum": 64, "maximum": 16384}
          }
        },
        "overrides": {
          "type": "object", "additionalProperties": false,
          "description": "Mapa parcial e plano. Ausência preserva o valor da tabela; null não é aceito. Nomes/unidades serão compartilhados com presets.zon no item 3.",
          "properties": {
            "shadows_enabled": {"type": "boolean"},
            "shadow_map_size": {"enum": [256, 512, 1024, 2048, 4096, 8192]},
            "shadow_cascades": {"type": "integer", "minimum": 1, "maximum": 4},
            "shadow_distance_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000},
            "msaa_samples": {"enum": [1, 2, 4, 8]},
            "draw_distance_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000},
            "texture_max_dimension": {"enum": [256, 512, 1024, 2048, 4096, 8192, 16384]},
            "texture_mip_bias": {"type": "number", "minimum": -4, "maximum": 4},
            "texture_anisotropy": {"enum": [1, 2, 4, 8, 16]},
            "post_processing_enabled": {"type": "boolean"},
            "bloom_enabled": {"type": "boolean"},
            "ambient_occlusion_enabled": {"type": "boolean"},
            "tone_mapping": {"enum": ["none", "reinhard", "aces"]}
          }
        }
      }
    },
    "scenes": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "startup"],
      "properties": {
        "root": {"$ref": "#/$defs/relativePath"},
        "startup": {"allOf": [{"$ref": "#/$defs/relativePath"}, {"pattern": "\\.scene$"}]}
      }
    },
    "scripts": {
      "type": "object", "additionalProperties": false,
      "required": ["cpp_root", "lua_root"],
      "properties": {
        "cpp_root": {"$ref": "#/$defs/relativePath"},
        "lua_root": {"$ref": "#/$defs/relativePath"},
        "cpp_module": {"type": ["string", "null"], "enum": [null, "static", "dynamic"], "default": null},
        "cpp_library": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/relativePath"}], "default": null},
        "lua_entry": {"oneOf": [{"type": "null"}, {"allOf": [{"$ref": "#/$defs/relativePath"}, {"pattern": "\\.lua$"}]}], "default": null}
      },
      "allOf": [
        {
          "if": {"required": ["cpp_module"], "properties": {"cpp_module": {"const": "dynamic"}}},
          "then": {"required": ["cpp_library"], "properties": {"cpp_library": {"$ref": "#/$defs/relativePath"}}},
          "else": {"properties": {"cpp_library": {"type": "null"}}}
        }
      ]
    },
    "assets": {
      "type": "object", "additionalProperties": false,
      "required": ["root"],
      "properties": {"root": {"$ref": "#/$defs/relativePath"}}
    },
    "simulation": {
      "type": "object", "additionalProperties": false,
      "required": ["fixed_tick_hz", "seed"],
      "properties": {
        "fixed_tick_hz": {"type": "integer", "minimum": 1, "maximum": 1000},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string", "minLength": 1, "maxLength": 1024,
      "description": "Checagem lexical parcial. Contenção, segmentos e links são validados semanticamente; todos os caminhos são relativos ao diretório do .proj.",
      "pattern": "^[^/\\\\:\\u0000-\\u001f\\u007f]+(?:/[^/\\\\:\\u0000-\\u001f\\u007f]+)*$"
    },
    "semver": {
      "type": "string", "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
